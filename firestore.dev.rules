rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ⚠️ RÈGLES DEV UNIQUEMENT — NE JAMAIS DÉPLOYER EN PRODUCTION
    // Ces règles permettent l'accès sans authentification pour
    // les tests E2E Playwright qui utilisent le bypass AuthContext.
    //
    // Déploiement : firebase deploy --only firestore:rules
    // (le projet par défaut est budgetflow-86842)

    // Allow all reads/writes without auth for development
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
