{
  "name": "budget-flow",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "backup:firestore": "node scripts/backup-firestore.js",
    "backup:daily": "bash scripts/backup-firestore-daily.sh",
    "notifications:generate-sw": "node scripts/generate-sw.js",
    "restore:firestore": "node scripts/restore-firestore.js",
    "restore:full": "bash scripts/restore-firestore-full.sh",
    "copy:user-data": "node scripts/copy-user-data.js",
    "seed:test-data": "node scripts/seed-test-data.js",
    "predev": "npm run notifications:generate-sw",
    "dev": "next dev --webpack -p 8091 -H 127.0.0.1",
    "prebuild": "npm run notifications:generate-sw",
    "build": "next build",
    "prestart": "npm run notifications:generate-sw",
    "start": "next start -p 8095 -H 127.0.0.1",
    "lint": "eslint .",
    "notifications:trigger": "node scripts/trigger-notifications.js",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:new": "playwright test --config=playwrightTest/playwright.config.ts",
    "test:e2e:new:headed": "playwright test --config=playwrightTest/playwright.config.ts --headed",
    "test:e2e:auth": "playwright test --config=playwrightTest/playwright.config.ts --project=auth-setup --headed",
    "test:e2e:seed": "node scripts/seed-test-data.js --confirm --replace-existing"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "dotenv": "^17.2.3",
    "firebase": "^12.8.0",
    "firebase-admin": "^13.8.0",
    "framer-motion": "^11.0.0",
    "lucide-react": "^0.562.0",
    "next": "^16.2.3",
    "react": "^19.2.3",
    "react-dom": "^19.2.3",
    "recharts": "^3.7.0",
    "server-only": "^0.0.1",
    "tailwind-merge": "^3.4.0",
    "tailwindcss-animate": "^1.0.7"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.5.2",
    "@types/jest": "^29.5.14",
    "@types/node": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "^10.4.23",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.2.3",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "tailwindcss": "^3.4.17",
    "ts-jest": "^29.4.0",
    "typescript": "latest"
  },
  "overrides": {
    "fast-xml-parser": "^5.3.4",
    "@tootallnate/once": ">=3.0.1",
    "uuid": ">=11.1.1",
    "postcss": ">=8.5.10"
  }
}
