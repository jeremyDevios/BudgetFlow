# Firebase Configuration
NEXT_PUBLIC_FIREBASE_API_KEY=""
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=""  # Utiliser le domaine Firebase Auth du projet (ex: votre-projet.firebaseapp.com)
NEXT_PUBLIC_FIREBASE_PROJECT_ID=""
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=""
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=""
NEXT_PUBLIC_FIREBASE_APP_ID=""
NEXT_PUBLIC_FIREBASE_AUTH_HELPER_HOST=""  # Optionnel: laisser vide si identique a NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN

# =============================================
# Firebase Admin SDK (SERVEUR UNIQUEMENT - ne jamais exposer cote client)
# =============================================
FIREBASE_PROJECT_ID=""
FIREBASE_CLIENT_EMAIL=""
FIREBASE_PRIVATE_KEY=""  # Format: "-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"

# =============================================
# Securite interne
# =============================================
CRON_SECRET=""  # Secret pour l'endpoint cron de notifications (passer en header X-Cron-Secret)
